!DenotativeObjectWorkspace methodsFor: 'user interface support' stamp: 'HAW 2/21/2019 00:10:50' overrides: 16981519!
                 autoCompleterClass
	
	^DenotativeObjectCompleter ! !
!DenotativeObjectWorkspace methodsFor: 'user interface support' stamp: 'HAW 2/21/2019 00:11:31' overrides: 16981523!
                      editorClass

	^DenotativeObjectWorkspaceEditor ! !
!DenotativeObjectMessageSet methodsFor: 'private' stamp: 'HAW 8/21/2017 21:56:59' overrides: 50471849!
      contents: aText notifying: aController

	^[ super contents: aText notifying: aController ]
		on: UndeclaredVariable 
		do: [ :undeclaredVariable | undeclaredVariable handleForDenotativeObjectIn: self ].
! !
!DenotativeObjectMessageSet methodsFor: 'tdd' stamp: 'HAW 8/23/2017 15:24:15' overrides: 16796761!
              debugMethodTest

	^self debugDenotativeObjectMethodTest! !
!DenotativeObjectMessageSet methodsFor: 'tdd' stamp: 'HAW 8/23/2017 15:26:57' overrides: 16796770!
  runClassTests

	^self runDenotativeObjectTests! !
!DenotativeObjectMessageSet methodsFor: 'tdd' stamp: 'HAW 8/23/2017 15:28:37' overrides: 16796779!
           runMessageCategoryTests

	^self runDenotativeObjectMessageCategoryTests! !
!DenotativeObjectMessageSet methodsFor: 'tdd' stamp: 'HAW 8/23/2017 15:29:59' overrides: 16796791!
                  runMethodTest

	^self runDenotativeObjectMethodTest! !
