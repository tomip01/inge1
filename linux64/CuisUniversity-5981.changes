		ChangeList >> #scanDoIt.
		ChangeList >> #scanFile:from:to:.
		ChangeList >> #scanSpecificChangeRecordType.
		ChangeList >> #scanUpTo:informing:.
		ChangeList >> #scanCategory:class:meta:stamp:prior:overrides:.
		PositionableStream >> #skipSeparators.
