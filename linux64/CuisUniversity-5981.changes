                        next
	
	current := self peek.	
	^current.
! !
!TimeLineFilterStream methodsFor: 'enumerating'!
 peek
	
	| nextDate |
	
	nextDate := current.
	[ nextDate := nextDate next.
	(timeLineFilter includes: nextDate) ] whileFalse.

	^nextDate! !
!TimeLineFilterStream methodsFor: 'enumerating'!
  peekPrevious
	
	| nextDate |
	
	nextDate := current.
	[ nextDate := nextDate previous.
	(timeLineFilter includes: nextDate) ] whileFalse.

	^nextDate! !
!TimeLineFilterStream methodsFor: 'enumerating'!
                      previous
	
	current := self peekPrevious.	
	^current.
! !
!TimeLineFilterStream methodsFor: 'enumerating'!
