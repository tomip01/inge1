assertIsNotAccessingInstanceVariable: aMethodToPushUp
	
	aMethodToPushUp methodClass instVarNames 
		do: [ :instVarName | 
			(aMethodToPushUp accessesInstanceVariable: instVarName) ifTrue: [self signalMethodCannotAccessInstanceVariable]].!

