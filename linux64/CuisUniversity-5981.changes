                              test01

	| bytes utf8String utf32String stringAsIso8859s15 fe1 fe2 fe3 |
	bytes _ 'Hello World, �and�, ag�ita. ' asUtf8Bytes, #[208 155 208 190 209 128 208 181 208 188].
	utf8String _ Utf8String fromUtf8Bytes: bytes.
