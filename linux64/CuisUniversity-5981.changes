!String methodsFor: 'converting' stamp: 'jmv 6/6/2022 15:36:10' prior: 16948030!
    afterBlanksEndsWith: aTail

	^(self endsWith: aTail) and: [ self firstNonSeparator = (self size - aTail size + 1) ]
