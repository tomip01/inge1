!methodRemoval: TextEditor #messageSendsRanges: stamp: 'Install-5695-MultipleHighlightInMessageSet-JuanVuletich-2023Mar15-16h15m-jmv.001.cs.st 3/26/2023 16:56:33'!
messageSendsRanges: aRanges
	"aRanges must be notEmpty"
	| lastRange |

	lastRange := nil.
	aRanges do: [ :range |
		( lastRange isNil or: [ range first > lastRange first ]) ifTrue: [
			lastRange _ range ]].

	self selectFrom: lastRange first to: lastRange last!

