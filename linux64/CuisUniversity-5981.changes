                   addTestsOf: aClass 
	| testReference |
	
	aClass allTestSelectors do: [ :selector |
		testReference := UninstalledMethodReference selector: selector class: aClass name.
		self newTest: testReference
	]! !
!TestInventory methodsFor: 'private' stamp: 'MGD 10/10/2019 20:16:08'!
