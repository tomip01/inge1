  nextPutByte: aByte 
	"Insert the argument at the next position in the Stream represented by the receiver."

	position >= writeLimit
		ifTrue: [^ self pastEndPutByte: aByte]
		ifFalse: [
			position _ position + 1.
			^collection at: position put: aByte]! !
