!TTContourConstruction methodsFor: 'printing' overrides: 16902975!
                      printOn: aStream

	aStream
		nextPutAll: self class name;
		nextPut:$(;
		print: points size;
		"space;
		print: self type;"
		nextPut:$)! !
!TTContourConstruction methodsFor: 'accessing' stamp: 'jmv 5/16/2019 16:35:20'!
   controlPointFlags
	^controlPointFlags! !
