    crc16OfFileNamed: fileName
	"
	EncodedFileStream crc16OfFileNamed: 'cursor.jpeg'
	EncodedFileStream crc16OfFileNamed: 'deafultPID.txt'
	"

	^[fileName asFileEntry readStreamDo: [ :stream |
		stream crc16 ]]
			on: FileDoesNotExistException do: nil! !
