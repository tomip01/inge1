toggleCollapseOrShow
	"If collapsed, show me.
	If visible, collapse me."

	owner ifNil: [ ^self ].
	(self visible and: [self atFront])
		ifTrue:  [ self collapse ]
		ifFalse: [ self showAndComeToFront ]!

