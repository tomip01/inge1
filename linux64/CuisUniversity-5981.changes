!CompoundMeasure methodsFor: 'arithmetic operations' stamp: 'HAW 11/9/2021 17:53:47' overrides: 50523752!
                         ^ aPower

	| powered |
	
	aPower = 0 ifTrue: [ ^1 ].
	
	powered := self.
	aPower abs - 1 timesRepeat: [ powered := powered * self ].
	
	^aPower > 0
		ifTrue: [ powered ]
		ifFalse: [ 1 / powered ]
	 ! !
