	self assertIsLogged: aString times: 1 and: aBlock! !
!ChangesTest methodsFor: 'assertions' stamp: 'HAW 11/1/2019 17:03:30'!
                          assertIsLoggedTwice: aString

	self assertIsLogged: aString times: 2 and: [:logContents :nextPosition | ] ! !
