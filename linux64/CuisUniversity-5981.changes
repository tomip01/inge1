!methodRemoval: InnerTextMorph #updateInitialSelection stamp: 'Install-5742-RemoveBuggyHighlight-JuanVuletich-2023Apr02-18h37m-jmv.001.cs.st 4/4/2023 15:40:00'!
updateInitialSelection

	| s |
	s := model getSelection.
	s ifNotNil: [
		s = #all ifFalse: [
			styler ifNotNil: [
				s := (styler positionInFormattedTextFor: s first)
					to: (styler positionInFormattedTextFor: s last) ]]].
	self setSelection: s.
	self redrawNeeded.!

