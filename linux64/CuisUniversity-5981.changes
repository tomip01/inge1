onForm: aForm over: aRectangle
	"Warning: aForm extent must equal aRectangle extent"

	^ self subclassToUse basicNew
		setForm: aForm subPixelAntiAliasing: false;
		initializeWithTranslation: aRectangle topLeft negated.!

