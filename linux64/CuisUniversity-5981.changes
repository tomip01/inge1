!ExtractMethodApplier methodsFor: 'private - reordering parameters' stamp: 'HAW 7/19/2023 18:29:16'!
              hasSameActualArgumentsAsTheProposedOnes

	^ self newMessageArgumentNames asSet = userArgumentNames asSet! !
