	color _ Color random.
	self redrawNeeded.! !
!Sample04Pacman methodsFor: 'updating' stamp: 'jmv 9/2/2021 16:59:16' overrides: 16895153!
              redrawNeeded
	"for experimenting with collision detection"

	self isOwnedByHand ifTrue: [
		self world ifNotNil: [ :w |
			w submorphsDo: [ :m |
				(self collides: m) ifTrue: [
					m class == self class
						ifTrue: [ m colorize ]
						ifFalse: [ m delete ]]]]].

	^super redrawNeeded! !
