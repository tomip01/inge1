			DirectoryEntry smalltalkImageDirectory / 'TrueTypeFonts'/ 'AlexBrush' // 'AlexBrush-Regular.ttf' ]! !
!Sample09Clock methodsFor: 'drawing' stamp: 'jmv 9/15/2021 15:27:51' overrides: 50352739!
   drawOn: aCanvas

