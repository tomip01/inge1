!AbstractVectorCanvas methodsFor: 'stroke & fill' stamp: 'jmv 5/30/2023 09:54:56'!
                 strokeWidth: strokeWidth color: aStrokeColor strokeDashArray: sda strokeDashArrayOffset: sdao do: pathCommandsBlock
