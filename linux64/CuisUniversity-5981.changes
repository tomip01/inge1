!Utf8String methodsFor: 'printing' stamp: 'jmv 5/27/2022 17:33:44' overrides: 16903050!
  storeOn: aStream 
	"Print inside string quotes, doubling inbedded quotes."
	| x |
	aStream nextPut: $'.
	1 to: self size do: [ :i |
		aStream nextPut: (x _ self at: i).
		x = $' ifTrue: [aStream nextPut: x]].
	aStream nextPut: $'! !
