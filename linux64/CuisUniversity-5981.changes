	0
		to: height - 1
		do: [ :y |
			0
				to: width - 1
				do: [ :x |
					dy := height - r - y.
					dy > 0
						ifTrue: [ l := 1.0 ]
						ifFalse: [
							d := (x @ dy) r.
							l := ((r - d max: 0.0) min: aaw) / aaw ].
					f
