      lineTo: aPoint
"
(VectorEngine onForm: Display subPixelAntiAliasing: true)
	strokeWidth: 1.0 color: Color black do: [ :engine |
		engine
			moveTo: 100@100;
			lineTo: 300@150 ].
Display forceToScreen
"
"
