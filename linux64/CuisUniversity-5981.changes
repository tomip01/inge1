!AbstractVectorCanvas methodsFor: 'drawing - icons' stamp: 'jmv 8/2/2021 14:35:41' overrides: 16896008!
          drawExpandedAt: aPoint
	"For Tree View (IndentingListItemMorph)"

	self fillColor: `Color gray` do: [
		self moveTo: aPoint.
		self rel_MoveTo: `0 @ -4`;
			rel_LineTo: `5@10`;
			rel_LineTo: `5 @ -10`;
