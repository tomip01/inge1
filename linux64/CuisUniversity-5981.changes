!CompoundMeasureFraction methodsFor: 'arithmetic operations' stamp: 'GabrielOmarCotelli 9/18/2009 20:53' overrides: 16863633!
                              = anObject

	^self class = anObject class ifTrue:[ (numerator * anObject denominator) = (denominator * anObject numerator)  ]
	ifFalse:[super = anObject 		]! !
!CompoundMeasureFraction methodsFor: 'arithmetic operations' stamp: 'GabrielOmarCotelli 9/18/2009 20:45' overrides: 16863732!
  isFraction

	^false! !
!CompoundMeasureFraction methodsFor: 'arithmetic operations' overrides: 16864042!
                       truncated

	InvalidUnaryOperationException signalOperationName: 'truncated' operand: self! !
!CompoundMeasureFraction methodsFor: 'private'!
                   numerator: aNumerator denominator: aDenominator

	self setNumerator: aNumerator denominator: aDenominator! !
!CompoundMeasureFraction methodsFor: 'private' overrides: 16864062!
               setNumerator: aNumerator denominator: aDenominator

	aDenominator = 0
		ifTrue: [^(ZeroDivide dividend: aNumerator) signal]
		ifFalse: 
			[numerator := aNumerator.
			denominator := aDenominator]! !
!CompoundMeasureFraction methodsFor: 'printing' overrides: 16863942!
                   printOn: aStream base: base

	aStream nextPut: $(.
	numerator printOn: aStream.
	aStream nextPut: $/.
	denominator printOn: aStream.
	aStream nextPut: $)! !
!IntervalAwareMagnitude methodsFor: 'comparing' overrides: 16881727!
                              = anObject

	^self == anObject! !
!IntervalAwareMagnitude methodsFor: 'comparing' overrides: 16881757!
                         hash

	^self identityHash! !
!IntervalAwareMagnitude methodsFor: 'magnitude protocol'!
         between: min andNotInclusive: max

	 ^min <= self and: [self < max]! !
!IntervalAwareMagnitude methodsFor: 'magnitude protocol'!
                               notInclusiveBetween: min and: max

	 ^min < self and: [self <= max]! !
!IntervalAwareMagnitude methodsFor: 'magnitude protocol'!
                               notInclusiveBetween: min andNotInclusive: max

	 ^min < self and: [self < max]! !
!IntervalAwareMagnitude methodsFor: 'interval protocol - private'!
           defaultIntervalIncrement

	self subclassResponsibility! !
!IntervalAwareMagnitude methodsFor: 'interval protocol - private'!
   intervalStrategy

	self subclassResponsibility! !
