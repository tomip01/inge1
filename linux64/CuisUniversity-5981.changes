                          accept: aVisitor
	| visitMethod |
	self isTypeAClass 
		ifTrue: [ visitMethod _ ('visit', type name, 'Preference:') asSymbol ]
		ifFalse: [visitMethod _ ('visit', type species, 'Preference:') asSymbol ].
	aVisitor perform: visitMethod with: self! !
