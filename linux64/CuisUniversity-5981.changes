               hideSelectedMorph

	self selectedClass delete! !
!DenotativeObjectBrowser methodsFor: 'morph handling' stamp: 'RNG 9/27/2018 11:18:58'!
                        showSelectedMorph

	self selectedClass openInWorld! !
