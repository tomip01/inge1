		ifTrue: [ aBlock valueWithArguments: values ]
		ifFalse: [ 
			#(true false) do: [ :value | 
				values at: aPosition put: value. 
				self evaluate: aBlock collectingValuesInto: values at: aPosition - 1 ]]! !
