!classDefinition: #SHTextStylerST80 category: #'Tools-Syntax Highlighting' stamp: 'Install-5731-AssignmentArrowsInDebuggerAndSenders-JuanVuletich-2023Mar28-14h51m-jmv.001.cs.st 3/31/2023 17:19:15'!
