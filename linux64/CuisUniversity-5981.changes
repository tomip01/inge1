               fullyCovers: aRectangle
	"Answer whether our drawing completely covers aRectangle.
	Answer true only if we are certain."

	^ self fullyCoveredRectangle
		ifNotNil: [ :r | r containsRect: aRectangle ]
		ifNil: [false].! !

