scrollMySiblings
	"vertical scroll my siblings along with my self"
	| yOffset |
	yOffset := self scrollerOffset y.
	scrollSiblings ifTrue: [
		self vScrollLeftSibling:  yOffset; 
			vScrollRightSibling: yOffset
	]!

