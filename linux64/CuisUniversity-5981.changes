	^ (self commandAltKeyPressed or: [ self controlKeyPressed ])
		and: [self keyCharacter = $w].! !
!KeyboardEvent methodsFor: 'testing' stamp: 'jmv 7/3/2023 12:17:33' prior: 16877427!
           isFindClassShortcut

	self flag: #definesKeyboardShortcuts.
	^ self shiftPressed and: [ self isReturnKey ].! !
!TheWorldMenu class methodsFor: 'menu building' stamp: 'jmv 7/3/2023 15:08:53' prior: 50411330!
                 helpMenuOptions

	^ `{
			{
				#submenuOf -> 					TheWorldMenu helpLabel.
