	"For Tree View (IndentingListItemMorph)"

	self fillColor: `Color gray` do: [
		self moveTo: aPoint.
		self rel_MoveTo: `2@ -5`;
			rel_LineTo: `10@5`;
			rel_LineTo: `-10 @ 5`;
			rel_LineTo: `0 @ -10` ].! !
