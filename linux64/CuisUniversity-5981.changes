!Array methodsFor: 'printing' stamp: 'jmv 9/6/2022 21:49:02' prior: 16780933 overrides: 16781394!
                          storeOn: aStream 
	"Use the literal form if possible."

	self isLiteral
		ifTrue: [
			aStream nextPut: $#; nextPut: $(.
			self do: [ :element | 
				element storeOn: aStream.
				aStream space].
			aStream nextPut: $)]
		ifFalse: [super storeOn: aStream]! !

