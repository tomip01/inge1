         newUIProcessIfNeeded
	"Answer is not nil only if a new process was created."

	UIProcess ifNotNil: [ :oldUIProcess |
		oldUIProcess isSuspended ifTrue: [ oldUIProcess terminate ].
		oldUIProcess isTerminated ifTrue: [
