         topLeftCorner: r height: height
	"Create and answer a Form for the topLeft corner of a rounded rectangle"
	| f bw l d w |
	w := r.
	bw := 1.3.
	f := Form
		extent: w @ height
		depth: 32.
	0
		to: height - 1
		do: [ :y |
			0
				to: w - 1
				do: [ :x |
					l := 1.0.
					y < r ifTrue: [
						d := (w - 1 - x @ (w - 1 - y)) r.
						l := ((r - d max: 0.0) min: bw) / bw ].
					f
						colorAt: x @ y
						put: (`Color white` alpha: l) ]].
	^ f! !
