                          writeOn: aStream 

	| w |
	aStream nextInt32Put: self basicSize bigEndian: true.

	1 to: self basicSize do: [ :i |
		w := self basicAt: i.
		Smalltalk isLittleEndian
			ifFalse: [ aStream nextUint32Put: w bigEndian: true ]
			ifTrue: [ aStream
				nextPut: (w digitAt: 2);
				nextPut: (w digitAt: 1);
				nextPut: (w digitAt: 4);
				nextPut: (w digitAt: 3) ]].! !
