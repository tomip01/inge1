'From Cuis 6.0 [latest update: #5979] on 12 August 2023 at 4:58:40 pm'!
!UnicodeString methodsFor: 'accessing' stamp: 'jmv 8/12/2023 16:54:23' prior: 50459233!
                    indexOfAnyOf: aCharacterSet startingAt: start ifAbsent: aBlock
	"returns the index of the first character in the given set, starting from start."

	"Fast lane."
	| index |
	self isAscii ifTrue: [
		^ bytes indexOfAnyOf: aCharacterSet startingAt: start ifAbsent: aBlock ].
	aCharacterSet isAscii ifTrue: [
		^ self codePointIndexAt: (bytes indexOfAnyOf: aCharacterSet startingAt: start ifAbsent: aBlock) ].

	index := start.
	self do: [ :codePoint |
		(aCharacterSet includes: codePoint) ifTrue: [ ^index ].
		index := index + 1].

	^aBlock value! !

----End fileIn of /Users/hernan/Documents/Cuis/5.0-64Bits/Cuis-Smalltalk-Dev/CoreUpdates/5980-UnicodeString-fix-JuanVuletich-2023Aug12-16h58m-jmv.001.cs.st----!

'From Cuis 6.0 [latest update: #5980] on 13 August 2023 at 6:46:57 pm'!
!UnicodeString methodsFor: 'accessing' stamp: 'jmv 8/13/2023 18:46:18' prior: 50510135!
                        indexOfAnyOf: aCharacterSet startingAt: start ifAbsent: aBlock
	"returns the index of the first character in the given set, starting from start."

	"Fast lane."
	| index |
	self isAscii ifTrue: [
		^ bytes indexOfAnyOf: aCharacterSet startingAt: start ifAbsent: aBlock ].
	aCharacterSet isAscii ifTrue: [ |startBI foundBI|
		startBI := self byteIndexAt: start.
		foundBI := bytes indexOfAnyOf: aCharacterSet startingAt: startBI ifAbsent: aBlock.
		^ self codePointIndexAt: foundBI ].

	index := start.
	self do: [ :codePoint |
		(aCharacterSet includes: codePoint) ifTrue: [ ^index ].
		index := index + 1].

	^aBlock value! !

----End fileIn of /Users/hernan/Documents/Cuis/5.0-64Bits/Cuis-Smalltalk-Dev/CoreUpdates/5981-FixJustPushedBuggyImplementation-JuanVuletich-2023Aug13-18h46m-jmv.001.cs.st----!

