		self signalMessageNodesReferenceSuper: nodesWithReferenceToSuper].! !
!IntroduceNullObject class methodsFor: 'assertions' stamp: 'FGJ 2/19/2019 19:26:36'!
                       assertBlocksDoNotContainReturnStatements: messageNodes

	messageNodes do: [
