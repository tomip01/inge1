!classDefinition: #TextParagraphMorph category: 'Morphic-Widgets' stamp: 'Install-5956-TextParagraphMorph-shrinkFromExtent-JuanVuletich-2023Jul27-14h01m-jmv.001.cs.st 8/3/2023 15:52:30'!
BoxedMorph subclass: #TextParagraphMorph
	instanceVariableNames: 'textComposition setsHeightOnContent shrinkFromExtent'
	classVariableNames: ''
