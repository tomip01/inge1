!EncodedString methodsFor: 'copying' stamp: 'jmv 6/6/2022 16:06:18'!
                         appendToText: aText

	| textStringSize |
	textStringSize := aText string size.
	^ aText replaceFrom: textStringSize + 1
			 to: textStringSize 
