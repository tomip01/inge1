	n elements have been read."
	| obj |
'--------' print.
thisContext printStack: 10.
self halt. "ojo"
	0 to: n-1 do: [ :i |
		(obj _ self nextByte) ifNil: [ ^aCollection copyFrom: 1 to: startIndex+i-1 ].
