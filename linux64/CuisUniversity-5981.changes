initializeRenamedNewMessageArguments: parseNodesToParameterize

	^ userArgumentNames with: parseNodesToParameterize do: [ :userArgumentName :currentArgument |  
		userArgumentName  ~= currentArgument name
			ifTrue: [ renamedNewMessageArguments at: currentArgument name put: userArgumentName]]!

ExtractMethodApplier removeSelector: #initializeNewMessageArguments:!

!methodRemoval: ExtractMethodApplier #initializeNewMessageArguments: stamp: 'Install-5935-ExtractMethodApplierImprovements-HernanWilkinson-2023Jul19-19h07m-HAW.001.cs.st 8/3/2023 15:52:29'!
initializeNewMessageArguments: parseNodesToParameterize

	^ parseNodesToParameterize with: newSelectorKeywords do: [ :parseNode :keyword | newMessageArguments at: keyword put: parseNode ]!

ExtractMethodApplier removeSelector: #argumentNamesOf:!

!methodRemoval: ExtractMethodApplier #argumentNamesOf: stamp: 'Install-5935-ExtractMethodApplierImprovements-HernanWilkinson-2023Jul19-19h07m-HAW.001.cs.st 8/3/2023 15:52:29'!
argumentNamesOf: userAnswer

	^(self keywordsAndArgumentsOf: userAnswer) pairsCollect: [ :keyword :argument | argument ].!

ExtractMethodApplier removeSelector: #calculateKewordsAndArgumentsNamesFrom:!

ExtractMethodApplier removeSelector: #selectorKeywordsOf:!

!methodRemoval: ExtractMethodApplier #selectorKeywordsOf: stamp: 'Install-5935-ExtractMethodApplierImprovements-HernanWilkinson-2023Jul19-19h07m-HAW.001.cs.st 8/3/2023 15:52:29'!
selectorKeywordsOf: userAnswer
	"this selects the pieces of strings before each $:"

	^ (self keywordsAndArgumentsOf: userAnswer) pairsCollect: [ :keyword :argument | keyword, ':' ]!

ExtractMethodApplier removeSelector: #initializeKewordsAndArgumentsNamesFrom:!

!methodRemoval: ExtractMethodApplier #initializeKewordsAndArgumentsNamesFrom: stamp: 'Install-5935-ExtractMethodApplierImprovements-HernanWilkinson-2023Jul19-19h07m-HAW.001.cs.st 8/3/2023 15:52:29'!
initializeKewordsAndArgumentsNamesFrom: userAnswer

	newSelectorKeywords := OrderedCollection new.
	userArgumentNames := OrderedCollection new.
	(self keywordsAndArgumentsOf: userAnswer) pairsDo: [ :keyword :argument | 
		newSelectorKeywords add: keyword, ':'.
		userArgumentNames add: argument ]!

ExtractMethodApplier removeSelector: #calculateNewMessageArguments:!

