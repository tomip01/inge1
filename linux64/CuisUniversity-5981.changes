	width := h * 3/4.
	halfWidth := width / 2.
	self fillColor: `Color gray` do: [
		self moveTo: aPoint.
		self rel_MoveTo: (h/4) @ halfWidth negated;
			rel_LineTo: width @ halfWidth;
			rel_LineTo: width negated @ halfWidth;
			rel_LineTo: 0 @ width negated.
		].! !
