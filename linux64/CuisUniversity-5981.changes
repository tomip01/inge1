[	x := ''''.
	[] ensure: [
		[Processor activeProcess suspend] ensure: [
		    [Processor activeProcess suspend] ensure: [
		        [Processor activeProcess suspend] ensure: [
		            x:=x,''3''].
		        x:=x,''2''].
		    x:=x,''1''].
		x:=x,''0'']
] newProcess resume.
Processor yield.
p terminate
