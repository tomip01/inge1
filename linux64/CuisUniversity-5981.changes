!FinderMorph methodsFor: 'initialization' stamp: 'HAW 3/14/2023 12:02:46' overrides: 16894075!
            openInWorld
	super openInWorld.
	self morphHeight: self defaultButtonPaneHeight * 9.
	self morphPositionInWorld: ((self runningWorld morphWidth / 2)  - (self morphWidth / 2)) @ 200.
	self comeToFront.

	"Disable focusFollowsMouse while the finder is open."
	focusFollowsMouse _ Preferences at: #focusFollowsMouse.
	focusFollowsMouse ifTrue: [Preferences at: #focusFollowsMouse put: false].
	"Set keyboard focus"
	self world ifNotNil: [ :w |
		w activeHand newKeyboardFocus: self submorphToFocusKeyboard ].
	FinderMorph current: self.! !
!FinderMorph methodsFor: 'submorphs-add/remove' stamp: 'HAW 7/11/2022 20:18:03' overrides: 16894992!
  delete
	super delete.
	FinderMorph current: nil.
	focusFollowsMouse ifTrue: [Preferences at: #focusFollowsMouse put: true ].
	Display restore.! !
