!PluggableListMorph methodsFor: 'layout' stamp: 'jmv 7/21/2023 10:18:06' prior: 50504180 overrides: 50504003!
                             maximumLayoutHeight
	| answer |
	limitLayoutHeight ifTrue: [
		answer := self desiredHeight.
		self hIsScrollbarShowing ifTrue: [
			answer := answer + ScrollBar scrollbarThickness].
		^answer ].
	^nil! !

