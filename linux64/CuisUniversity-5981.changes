			s _ `Color veryDarkGray` ]
		ifTrue: [
			c _ `(Color r: 0.996 g: 0.329 b: 0.329) * 0.85`.
			s _ `Color black` ].
	size _ currentMorph morphWidth.
	self strokeWidth: size/30.0 color: s fillColor: c do: [
