!Transcript class methodsFor: 'old Transcript compatibility' stamp: 'jmv 1/12/2023 12:41:54' prior: 50459758!
                              show: anObject
	"Old TranscriptStream protocol."
	"
	Transcript
	show: 'Hello

		World';
	show: 'Hello
           
		World';
	newLine;
	show: 'stuff';
	newLine;
	newLine;
	show: 'done '; show: 'yeah'.
	"
	(anObject asString findTokens: `{Character newLineCharacter}` keep: `{Character newLineCharacter}`)
		do: [ :line |
			line = Character newLineCharacter asString
				ifFalse: [ self nextPutAll: line ]
				ifTrue: [ self newLine ]]! !
