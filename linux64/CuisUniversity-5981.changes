	i _ byteIndex+2.
	byte3 _ i <= s ifTrue: [aByteArray at: i].
	i _ byteIndex+3.
	byte4 _ i <= s ifTrue: [aByteArray at: i].

	^self
		utf8BytesAndCodePointFor: byte1
		byte2: byte2
		byte3: byte3
		byte4: byte4
		into: bytesBlock
