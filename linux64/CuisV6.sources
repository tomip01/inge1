!Theme methodsFor: 'icons' stamp: 'jmv 11/19/2020 17:21:02'!
                        haloScaleIcon

	^ Form
		small1BitExtent: 16@16
		pixelBits: #(
			2r0000000000000000
			2r0000000000000000
			2r0000111110000000
			2r0001000001000000
			2r0010001000100000
			2r0010001000100000
			2r0010111110100000
			2r0010001000100000
			2r0010001000100000
			2r0001000001100000
			2r0000111110010000
			2r0000000000001000
			2r0000000000000100
			2r0000000000000010
			2r0000000000000000
			2r0000000000000000)
		offset: 0@0! !

