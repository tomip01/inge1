		selectedClass _ Smalltalk classNamed: aClassName.
		(ProgressiveTestRunner for: (TestSuite forClass: selectedClass)) value ]! !

!Browser methodsFor: 'tdd' stamp: 'HAW 2/28/2019 20:30:14'!
             runMessageCategoryTests
	
