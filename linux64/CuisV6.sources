	^ 'Widgets'! !
!classDefinition: #ProgressiveTestRunner category: #'Tools-Testing'!
Object subclass: #ProgressiveTestRunner
	instanceVariableNames: 'testSuite testsStream progressBar testResult testRunIncrement'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Tools-Testing'!

!ProgressiveTestRunner methodsFor: 'initialization' stamp: 'HAW 2/1/2017 19:20:06'!
                     initializeFor: aTestSuite

	testSuite _ aTestSuite.
	! !


!ProgressiveTestRunner methodsFor: 'evaluating' stamp: 'HAW 3/6/2019 15:35:58'!
                     value

	Utilities authorInitials.
	testsStream _ ReadStream on: testSuite tests.
	testsStream atEnd
		ifTrue: [ self informNoTestToRun ]
	 	ifFalse:[ self createProgressBarAndRun ]! !


!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 1/31/2017 10:25:22'!
         calculateTestRunIncrement
	
	testRunIncrement _ 1/testsStream size! !

!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 1/31/2017 10:25:31'!
                            createProgressBar
		
	progressBar _ ProgressMorph label: testSuite name.
	self calculateTestRunIncrement.
	self updateProgressBarSubLabel.
	! !

!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 1/31/2017 10:25:43'!
                  updateDoneIncrement 

 	progressBar incrDone: testRunIncrement 
	! !

!ProgressiveTestRunner methodsFor: 'progress bar - private' stamp: 'HAW 1/31/2017 11:10:25'!
                             updateProgressBarSubLabel

	testsStream atEnd ifFalse: [
		progressBar subLabel: testsStream next printString, ' (', testsStream position printString, '/', testsStream size printString, ')' ].! !


!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 1/31/2017 20:05:25'!
                              informAllTestPassed 
	
	PopUpMenu inform: testResult printString.
	! !

!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 1/31/2017 10:05:21'!
                            informNoTestToRun
		
	 PopUpMenu inform: 'No test to run'! !

!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 6/3/2017 20:40:29'!
       openTestResultWindow

	TestResultWindow openFor: testResult 
	! !

!ProgressiveTestRunner methodsFor: 'show result - private' stamp: 'HAW 2/28/2019 20:30:59'!
 showDeffects
	
	 | defects |
			
	defects _ testResult defects.
	defects size = 1
		ifTrue: [ defects anyOne debug ] 
		ifFalse: [ self openTestResultWindow]! !


!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 2/1/2017 19:14:08'!
   createProgressBarAndRun

	self createProgressBar.
	[ self runSuiteShowingProgress ] fork! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 2/1/2017 19:26:59'!
         registerTestSuiteAction
		
	testSuite when: #changed: send: #testRun: to: self! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 1/31/2017 10:09:41'!
                  runSuite
		
	testResult _ testSuite run.	
	testResult hasPassed 
		ifTrue: [ self informAllTestPassed ] 
		ifFalse: [self showDeffects ]
	! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'jmv 12/28/2017 15:40:01'!
                     runSuiteShowingProgress

	[ self registerTestSuiteAction. 
	progressBar openInWorld.
	self runSuite ] ensure: [
		self unregisterTestSuiteAction.
		UISupervisor whenUIinSafeState: [progressBar dismissMorph] ].
	! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 2/1/2017 19:19:28'!
              testRun: aTest

	self updateProgressBarSubLabel.
	self updateDoneIncrement 
	
		! !

!ProgressiveTestRunner methodsFor: 'evaluating - private' stamp: 'HAW 1/31/2017 10:04:32'!
                unregisterTestSuiteAction
	
	testSuite releaseActionMap ! !

