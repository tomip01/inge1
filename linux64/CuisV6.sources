	suite _ TestSuite forCompiledMethod: currentCompiledMethod.
	(ProgressiveTestRunner for: suite) value 
	! !

!Browser methodsFor: 'tdd' stamp: 'HAW 2/28/2019 20:30:14'!
                         runSystemCategoryTests
	
