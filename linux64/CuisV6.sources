                            haloResizeIcon

	^ Form
		small1BitExtent: 16@16
		pixelBits: #(
			2r0000000000000000
			2r0000000000000000
			2r0000000000000000
			2r0000000000000000
			2r0000111111010000
			2r0000100001010000
			2r0000100001010000
			2r0000100001010000
			2r0000100001010000
			2r0000111111010000
			2r0000000000010000
			2r0000111111110000
			2r0000000000000000
			2r0000000000000000
			2r0000000000000000
			2r0000000000000000)
		offset: 0@0! !

