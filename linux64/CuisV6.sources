!classDefinition: 'PasteUpMorph class' category: #'Morphic-Kernel'!
PasteUpMorph class
	instanceVariableNames: ''!

!PasteUpMorph class methodsFor: 'system startup' stamp: 'jmv 12/30/2021 13:11:25'!
