	self
		setPreference: #classFinder
		toValue: aBlock! !

!Preferences class methodsFor: 'class finder' stamp: 'NPM 1/29/2021 17:02:24'!
  restoreDefaultClassFinder

	| defaultClassFinder |
	defaultClassFinder _ [ BrowserWindow findClass ].
	
	self classFinder: defaultClassFinder.
	
	^ defaultClassFinder! !


