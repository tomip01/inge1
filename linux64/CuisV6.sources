!Text methodsFor: 'printing' stamp: 'len 6/7/2016 21:51'!
                printOn: aStream
	aStream isText
		ifTrue: [aStream nextPutAll: self. ^ self].
	self printNameOn: aStream.
	aStream nextPutAll: ' for '; print: string! !

