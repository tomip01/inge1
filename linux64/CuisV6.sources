		ifFalse: [ 'size' ].
	^ (SimpleServiceEntry
		provider: self
		label: 'by size'
		selector: #sortBySize
		description: 'sort entries by size'
		icon: #sendReceiveIcon)
			extraSelector: #sortingBySize;
