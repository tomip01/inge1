	outerContext printOn: aStream! !

!BlockClosure methodsFor: 'printing' stamp: 'jmv 2/23/2011 16:04'!
   printStack: depth
	self print.
	depth > 0 ifTrue: [
		self sender ifNotNil: [ :s | s printStack: depth-1 ]]! !

