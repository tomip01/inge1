!ChangeList methodsFor: 'accessing' stamp: 'Squeak1.0 9/20/1996 10:50:05'!
                  changeList
	^ changeList! !

!ChangeList methodsFor: 'accessing' stamp: 'jmv 3/5/2013 11:34'!
  contentsSymbol

	self currentChange ifNotNil: [ :change |
		(self isNewMethod: change) ifTrue: [ ^#source ]].
	^super contentsSymbol! !

!ChangeList methodsFor: 'accessing' stamp: 'jmv 6/17/2012 11:57'!
                     currentChange
	"return the current change being viewed, or nil if none"

	^ listIndex = 0
		ifFalse: [ changeList at: listIndex ]! !

