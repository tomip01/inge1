	^variable! !


!AssignmentNode methodsFor: 'initialization' stamp: 'Squeak1.0 9/20/1996 10:50:05'!
                   toDoIncrement: var
	var = variable ifFalse: [^ nil].
	(value isMemberOf: MessageNode) 
		ifTrue: [^ value toDoIncrement: var]
		ifFalse: [^ nil]! !

!AssignmentNode methodsFor: 'initialization' stamp: 'Squeak1.0 9/20/1996 10:50:05'!
