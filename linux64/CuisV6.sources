      initClassCachedState

	LastTickSemaphore := Semaphore forMutualExclusion.
	LastTick := 0! !

!DateAndTime class methodsFor: 'system startup & shutdown' stamp: 'jmv 11/9/2021 16:57:39'!
       releaseClassCachedState

	LastTickSemaphore _ nil.
