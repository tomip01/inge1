                  fixedWidth: aNumber proportionalHeight: otherNumber

	^self new
		fixedWidth: aNumber;
		proportionalHeight: otherNumber! !

!LayoutSpec class methodsFor: 'instance creation' stamp: 'KenD 5/22/2020 13:54:56'!
               fixedWidth: aNumber proportionalHeight: otherNumber offAxisEdgeWeight: aSymbolOrNumber

	^self new
		fixedWidth: aNumber;
		proportionalHeight: otherNumber;
		offAxisEdgeWeight: aSymbolOrNumber! !

!LayoutSpec class methodsFor: 'instance creation' stamp: 'jmv 2/24/2011 12:29'!
          keepMorphExtent
	^self new
		useMorphWidth;
		useMorphHeight! !

!LayoutSpec class methodsFor: 'instance creation' stamp: 'jmv 12/30/2011 11:59'!
              morphHeightFixedWidth: aNumber

	^self new
		fixedWidth: aNumber;
		useMorphHeight! !

