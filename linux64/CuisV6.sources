isPartialOrFullIdentifier: aSymbol

	^(self isIdentifier: aSymbol) or: [ self isReservedName: aSymbol ]! !

!SHParserST80 methodsFor: 'testing' stamp: 'HAW 5/3/2020 00:27:56'!
