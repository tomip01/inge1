!Date methodsFor: 'smalltalk-80' stamp: 'jmv 4/9/2010 09:44'!
                 previous: dayName 
	"Answer the previous date whose weekday name is dayName."

	| n |
	n _ 7 + self weekdayIndex - (self class dayOfWeek: dayName) \\ 7.
	n = 0 ifTrue: [ n _ 7 ].
	^ self - n days! !

