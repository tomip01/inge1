	self redrawNeeded ! !

!PluggableButtonMorph methodsFor: 'enabling' stamp: 'KenD 11/28/2021 14:18:11'!
                      enable

	enableSelector := true.
	self update: #enableSelector.
	self redrawNeeded ! !


