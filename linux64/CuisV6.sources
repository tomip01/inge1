	^self shouldStyle 
		ifTrue: [ '<on> syntax highlighting' ]
		ifFalse: [ '<off> syntax highlighting' ]! !


!Workspace methodsFor: 'initialization' stamp: 'jmv 11/16/2020 10:41:49'!
