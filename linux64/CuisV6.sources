!Morph methodsFor: 'geometry' stamp: 'jmv 12/17/2021 11:05:24'!
                          externalizeToWorld: aPoint
	"aPoint is in own coordinates. Answer is in world coordinates."

	| inOwners |
	inOwners _ self externalize: aPoint.
