                              installPackage: aFileEntry

	| fullName pkName |
	fullName _ aFileEntry pathName.
	pkName _ CodePackageFile packageNameFrom: fullName.
	(FeatureRequirement name: pkName)
		pathName: fullName;
		satisfyRequirementsAndInstall "Install with all requirements"! !

