!SHRange methodsFor: 'printing' stamp: 'HAW 10/4/2020 19:12:52'!
                           printOn: aStream

	aStream 
		nextPutAll: type;
		space;
		nextPut: $(;
		print: start;
		nextPutAll: ' to: ';
		print: end;
		nextPut: $)! !

