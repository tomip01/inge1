           description
	
"Return a textual description of the exception."

	| desc |
	desc := self class name asString.
	^ self messageText
		ifNil: [ desc]
		ifNotNil: [ :mt | desc , ': ' , mt ]! !

!Exception methodsFor: 'exceptionDescription' stamp: 'tfei 6/4/1999 17:40'!
