            selectedClass
	^(self selectedClassOrMetaClass ifNil: [ ^nil ]) theNonMetaClass ! !

!ChangeList methodsFor: 'viewing access' stamp: 'jmv 1/31/2013 23:00'!
    selectedClassOrMetaClass
	| c |
	^ (c _ self currentChange) ifNotNil: [c changeClass]! !

!ChangeList methodsFor: 'viewing access' stamp: 'sma 2/5/2000 19:10'!
selectedMessageName
	| c |
