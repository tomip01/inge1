!Exception methodsFor: 'priv handling' stamp: 'ajh 2/1/2003 00:58'!
                               isResumable
	"Determine whether an exception is resumable."

	^ true! !

!Exception methodsFor: 'priv handling' stamp: 'SqR 11/15/2015 08:45'!
