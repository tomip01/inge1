	instanceVariableNames: ''!

!ReferencesExplorer class methodsFor: 'instance creation' stamp: 'sqr 12/26/2013 15:00'!
                          finder: aReferenceFinder

	^self new
		finder: aReferenceFinder;
		rootObject: aReferenceFinder target;
		yourself! !
