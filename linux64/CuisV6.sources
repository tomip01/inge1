	^ fileName ifNotNil: [ (directory // fileName) pathName ]! !

!FileList methodsFor: 'private' stamp: 'jmv 10/20/2015 12:24'!
                            isFileSmalltalkCode
	^fileName
		ifNil: [ false ]
