!Integer methodsFor: 'enumerating' stamp: 'ST-80 5/31/1983 9:10:35'!
   timesRepeat: aBlock 
	"Evaluate the argument, aBlock, the number of times represented by
	the receiver."

	| count |
	count _ 1.
	[count <= self]
		whileTrue: 
			[aBlock value.
			count _ count + 1]! !


