	"Default is to do nothing.
	 Subclasses may need to override."
	^0! !


!LeafNode methodsFor: 'private' stamp: 'jmv 8/28/2010 11:18'!
             code: idx type: type
	"Warning: index would be shadowed"
	idx ifNil: [
		^type negated].
	(CodeLimits at: type) > idx 
		ifTrue: [^(CodeBases at: type) + idx].
	^type * 256 + idx! !


!LeafNode methodsFor: 'code generation (new scheme)' stamp: 'eem 5/14/2008 14:52'!
