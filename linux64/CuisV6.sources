!classDefinition: 'BlockNodeParentsFinder class' category: #'Tools-Refactoring'!
BlockNodeParentsFinder class
	instanceVariableNames: ''!

!BlockNodeParentsFinder class methodsFor: 'instance creation' stamp: 'EB 12/18/2019 18:10:08'!
                            for: aSelectedBlockNode

	^self new initializeFor: aSelectedBlockNode.! !
!classDefinition: #BlockStartLocator category: #'Kernel-Methods'!
InstructionClient subclass: #BlockStartLocator
