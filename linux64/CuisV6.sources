!Notification methodsFor: 'debugger updating' stamp: 'HAW 12/26/2019 11:01:45'!
     isToUpdateDebuggerOn: aContext

	^tag isArray
		and: [tag size = 2
		and: [(tag first == aContext or: [tag first hasSender: aContext])]]! !

