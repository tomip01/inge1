!MouseMoveEvent methodsFor: 'dispatching' stamp: 'jmv 1/5/2021 12:02:43'!
      sendEventTo: aMorph
	"Dispatch the receiver into anObject"

	type == #mouseMove ifTrue: [
		^aMorph processMouseMove: self localPosition: (aMorph internalizeFromWorld: position) ].
	^ super sendEventTo: aMorph! !


!MouseMoveEvent methodsFor: 'testing' stamp: 'ar 9/13/2000 19:29'!
      isMove
	^true! !


!MouseMoveEvent methodsFor: 'private' stamp: 'jmv 8/19/2012 10:45'!
         setType: evtType position: evtEnd buttons: evtButtons hand: evtHand stamp: stamp

	type _ evtType.
	position _ evtEnd.
	buttons _ evtButtons.
