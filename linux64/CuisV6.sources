MouseClickState class
	instanceVariableNames: ''!

!MouseClickState class methodsFor: 'cached state access' stamp: 'jmv 11/20/2020 10:49:00'!
               doubleClickTimeout
	DoubleClickTimeout ifNil: [
		DoubleClickTimeout _ 500 ].
	^DoubleClickTimeout! !

