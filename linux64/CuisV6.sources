                    releaseClassCachedState
	SubMenuMarker _ nil! !

!MenuItemMorph class methodsFor: 'cached state access' stamp: 'jmv 11/19/2020 12:54:04'!
                      subMenuMarker

	| f |
	SubMenuMarker ifNotNil: [ ^SubMenuMarker ].
	f _ Form
		small1BitExtent: `5@9`
		pixelBits: #(
			2r10000
			2r11000
			2r11100
			2r11110
			2r11111
			2r11110
			2r11100
			2r11000
			2r10000).
	SubMenuMarker _ ColorForm mappingWhiteToTransparentFrom: f.
	^SubMenuMarker! !


