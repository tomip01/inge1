	self allSubInstancesDo: [ :each |
		each buildMagnifiedBackgroundImage.
		each redrawNeeded ].
	Cursor defaultCursor activateCursor.! !


!PasteUpMorph class methodsFor: 'new-morph participation' stamp: 'jmv 12/30/2021 13:11:25'!
