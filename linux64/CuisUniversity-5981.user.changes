!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:48:19' prior: 50680295!
calcularProfundidadDelSueloHasta: tipoDeCapa
	
	| valor |
	
	valor := tipoDeCapa scan.
	
	^ capasDeSueloDebajo 
		inject: 0
		into: [:profundidadAcumulada :unaCapaDeSuelo |
			unaCapaDeSuelo scan = valor ifTrue: [^profundidadAcumulada ].
			
			].
	
	 ! !
!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:48:40' prior: 50681682!
calcularProfundidadDelSueloHasta: tipoDeCapa
	
	| valorDeLaCapaDeSuelo |
	
	valorDeLaCapaDeSuelo := tipoDeCapa scan.
	
	^ capasDeSueloDebajo 
		inject: 0
		into: [:profundidadAcumulada :unaCapaDeSuelo |
			unaCapaDeSuelo scan = valorDeLaCapaDeSuelo ifTrue: [^profundidadAcumulada ].
			
			].
	
	 ! !
!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:48:51' prior: 50681693!
calcularProfundidadDelSueloHasta: tipoDeCapa
	
	| valorDeLaCapaDeSuelo |
	
	valorDeLaCapaDeSuelo := tipoDeCapa scan.
	
	^ capasDeSueloDebajo 
		inject: 0
		into: [:profundidadAcumulada :unaCapaDeSuelo |
			unaCapaDeSuelo scan = valorDeLaCapaDeSuelo ifTrue: [^profundidadAcumulada ].
			profundidadAcumulada + unaCapaDeSuelo altura
			].
	
	 ! !

