!GrandPrix methodsFor: 'simulation' stamp: 'tp 9/19/2023 16:07:18' prior: 50667243!
advance: aTimeLapse
	
	| ix cars |
	
	cars := track cars asOrderedCollection.
	
	cars do: [ :car |
			self relocate: car after: aTimeLapse ].
	
	ix := 1.
	[ix <= cars size] whileTrue: [ | car |
		car := cars at: ix.
		self relocate: car after: aTimeLapse.
		ix := ix + 1.
	]
! !
!GrandPrix methodsFor: 'simulation' stamp: 'tp 9/19/2023 16:07:30' prior: 50671138!
advance: aTimeLapse
	
	| cars |
	
	cars := track cars asOrderedCollection.
	
	cars do: [ :car |
			self relocate: car after: aTimeLapse ].
	
"	ix := 1.
	[ix <= cars size] whileTrue: [ | car |
		car := cars at: ix.
