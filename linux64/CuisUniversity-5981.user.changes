!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:49:23' prior: 50680315!
contarCapas: tipoDeCapa
	
	"Cuenta las capas de tipo tipoDeCapa. Recordar que para identificar cada capa se utiliza el valor de scan que retorna. Por ej. un capa tipo Arenoso retorna 7 al scan"
	
	| valorDeLaCapaDeSuelo acc ix |
	
	"valor := 0.
	tipoDeCapa = #Arenoso ifTrue: [ valor := 7 ].
	tipoDeCapa = #Tierra ifTrue: [ valor := 10 ].
	tipoDeCapa = #Concreto ifTrue: [ valor := 50].	"
	
	valorDeLaCapaDeSuelo :=  tipoDeCapa scan.
	
	acc := 0.
	ix := 1.
	
	[ix <= capasDeSueloDebajo size] whileTrue: [ | capa |
		capa := capasDeSueloDebajo at: ix.
		valorDeLaCapaDeSuelo = capa scan ifTrue: [ acc := acc + 1 ].
		ix := ix + 1.		
	].

	^ acc! !
!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:50:49' prior: 50681794!
contarCapas: tipoDeCapa
	
	"Cuenta las capas de tipo tipoDeCapa. Recordar que para identificar cada capa se utiliza el valor de scan que retorna. Por ej. un capa tipo Arenoso retorna 7 al scan"
	
	| valorDeLaCapaDeSuelo |
	
	valorDeLaCapaDeSuelo :=  tipoDeCapa scan.
	
	^ capasDeSueloDebajo count: [:unaCapaDeSuelo | unaCapaDeSuelo scan = valorDeLaCapaDeSuelo ]! !

