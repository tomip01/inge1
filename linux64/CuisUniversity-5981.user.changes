!classDefinition: #Numero category: 'Numero-Exercise' stamp: 'tp 9/9/2023 16:02:13'!
Object subclass: #Numero
	instanceVariableNames: 'type valueOld numerator denominator'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Numero-Exercise'!
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653582!
integerValue

	"Usamos integerValue en vez de value para que no haya problemas con el mensaje value implementado en Object - Hernan"
	
	^valueOld! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653475!
* aMultiplier 

	(type = #Entero and: [aMultiplier type = #Entero]) ifTrue:	
		[ ^self class with: valueOld * aMultiplier integerValue ].
		
	(type = #Fraccion and: [aMultiplier type = #Fraccion]) ifTrue:
		[ ^self class with: (numerator * aMultiplier numerator) over: (denominator * aMultiplier denominator) ].
		
	self error: 'Tipo de número no soportado'
	! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653542!
isNegative
	
	type = #Entero ifTrue:
		[ ^valueOld < 0 ].
	type = #Fraccion ifTrue:
		[ ^denominator < 0 ].! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653489!
+ anAdder 
	
	(type = #Entero and: [anAdder type = #Entero]) ifTrue:
		[ ^self class with: valueOld + anAdder integerValue ].
	
	(type = #Fraccion and: [anAdder type = #Fraccion]) ifTrue:
		[ | newNumerator newDenominator |
		
		newNumerator := (numerator * anAdder denominator) + (denominator * anAdder numerator).
		newDenominator := denominator * anAdder denominator.
		
		^ self class with: newNumerator over: newDenominator ].
	
	self error: 'Tipo de número no soportado'
	! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653507!
// aDivisor 
	
	type = #Entero ifTrue:
		[ ^self class with: valueOld // aDivisor integerValue ].
		
	self error: 'Tipo de número no soportado'! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653531 overrides: 16902975!
printOn: aStream
	
	type = #Entero ifTrue:
		[ aStream print: valueOld ].
	
	type = #Fraccion ifTrue:
		[ aStream 
			print: numerator;
			nextPut: $/;
			print: denominator ].! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653593 overrides: 16901772!
= anObject

	^(anObject isKindOf: self class) and: [ type = anObject type and: 
		[ type = #Entero ifTrue: [ valueOld = anObject integerValue] 
		ifFalse: [ type = #Fraccion ifTrue:
			[ (numerator * anObject denominator) = (denominator * anObject numerator) ]]]]! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653548!
isOne

	type = #Entero ifTrue:
		[ ^valueOld = 1 ].
	type = #Fraccion ifTrue:
		[ ^false ].! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653553!
isZero

	type = #Entero ifTrue:
		[ ^valueOld = 0 ].
	type = #Fraccion ifTrue:
		[ ^false ].! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653514!
greatestCommonDivisorWith: anEntero 
	
	type = #Entero ifTrue:
		[^self class with: (valueOld gcd: anEntero integerValue)].
		
	self error: 'Tipo de número no soportado'! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653559!
initializeWith: aValue
	
	type := #Entero.
	valueOld := aValue! !
!Numero methodsFor: 'as yet unclassified' stamp: 'tp 9/9/2023 16:02:13' prior: 50653604 overrides: 16901788!
hash
	type = #Entero ifTrue:
		[ ^valueOld hash ].
	type = #Fraccion ifTrue:
		[ ^(numerator hash / denominator hash) hash ].! !

