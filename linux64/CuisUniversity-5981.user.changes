!GrandPrix methodsFor: 'simulation' stamp: 'tp 9/19/2023 16:07:45' prior: 50671150!
advance: aTimeLapse
	
	| cars |
	
	cars := track cars asOrderedCollection.
	
	cars do: [ :car | self relocate: car after: aTimeLapse ].
