!methodRemoval: Fraccion #substractToFraccion2: stamp: 'tp 9/14/2023 13:32:10'!
substractToFraccion2: aFraccionMinuend 

	| newDenominator equivalentMinuendInCommonBase equivalentSubstraendInBase |
	newDenominator := aFraccionMinuend commonDenominatorWith: self.
	equivalentMinuendInCommonBase:= aFraccionMinuend convertToEquivalentInBase: newDenominator.
	equivalentSubstraendInBase:= self convertToEquivalentInBase: newDenominator.

	^equivalentMinuendInCommonBase numerator - equivalentSubstraendInBase numerator / newDenominator 
		
	
	
	
!
!Fraccion methodsFor: 'arithmetic operations' stamp: 'tp 9/14/2023 13:33:26'!
numerator: aFraccionOperand overCommonDenominatorWith: anOperationForTheNewNumerator
	
	| newNumerator newDenominator |
	
	newNumerator := anOperationForTheNewNumerator value.
	newDenominator := aFraccionOperand commonDenominatorWith: self.
		
	^newNumerator / newDenominator 
		
	
	
	
	
	
	
	! !
!Fraccion methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:33:26' prior: 50661479 overrides: 50660179!
multiplyToFraccion: aFraccion1stMultiplier 
	
	^ self numerator: aFraccion1stMultiplier 
		  overCommonDenominatorWith: [aFraccion1stMultiplier numerator * self numerator]
	

	
	

	
	! !
!Fraccion methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:33:26' prior: 50661488 overrides: 50660193!
substractToFraccion: aFraccionMinuend 
	
	^ self numerator: aFraccionMinuend 
		  overCommonDenominatorWith: [(aFraccionMinuend numerator * self denominator) - (aFraccionMinuend denominator * self numerator)]
		
	
	
	
! !
!Fraccion methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:33:26' prior: 50661459 overrides: 50660154!
addToFraccion: aFraccion1stAdder

	^ self numerator: aFraccion1stAdder 
		 overCommonDenominatorWith: [(aFraccion1stAdder numerator * self denominator) + (aFraccion1stAdder denominator * self numerator)]
		
	
	
	
	
	
	
	! !

!methodRemoval: Fraccion #withFraccion:operate: stamp: 'tp 9/14/2023 13:33:26'!
withFraccion: aFraccionOperand operate: anOperationForTheNewNumerator
	
	| newNumerator newDenominator |
	
	newNumerator := anOperationForTheNewNumerator value.
	newDenominator := aFraccionOperand commonDenominatorWith: self.
		
	^newNumerator / newDenominator 
		
	
	
	
	
	
	
	!
!Fraccion methodsFor: 'arithmetic operations' stamp: 'tp 9/14/2023 13:34:17' prior: 50661822 overrides: 50660193!
substractToFraccion: aFraccionMinuend 
	
	^ self numerator: [(aFraccionMinuend numerator * self denominator) - (aFraccionMinuend denominator * self numerator)] 
		  overCommonDenominatorWith: aFraccionMinuend
		
	
	
	
! !
