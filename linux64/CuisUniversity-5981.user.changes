!Perforadora methodsFor: 'cambiar capa' stamp: 'tp 9/20/2023 15:59:49' prior: 50678447!
pasarAProximaCapa
	vecesQueGolpeoCapaActual := 0.
	capasDeSueloDebajo := capasDeSueloDebajo allButFirst.
	capasDeSueloDebajo ifEmpty: [^self]. 
	(capasDeSueloDebajo first class superclass = CapaDeSuelo) ifFalse:[		      "la comparacion no se como hacerla mejor"
			container addAll: capasDeSueloDebajo.
		]! !
!Perforadora methodsFor: 'cambiar capa' stamp: 'tp 9/20/2023 16:00:17' prior: 50678458!
transformarCapaEnArenoso
	capasDeSueloDebajo :=
			capasDeSueloDebajo allButFirst asOrderedCollection
			addFirst: CapaDeSueloArenoso new;
			yourself! !
!Perforadora methodsFor: 'cambiar capa' stamp: 'tp 9/20/2023 16:00:37' prior: 50679205!
transformarCapaEnArenoso
	capasDeSueloDebajo :=
			capasDeSueloDebajo allButFirst asOrderedCollection
			addFirst: CapaDeSueloArenoso new; "CapaDeSuelo arenoso"
			yourself! !
!Perforadora methodsFor: 'excavation' stamp: 'tp 9/20/2023 16:03:40'!
descripcionErrorAlRomperseLaMecha

	^ self error: 'Se rompió'! !
!Perforadora methodsFor: 'excavation' stamp: 'tp 9/20/2023 16:03:40' prior: 50679138!
darGolpeDeTaladroEnArenoso

	mechaPuesta = #Soft ifTrue: [ ^self pasarAProximaCapa ].
	mechaPuesta = #Widia ifTrue: [ ^self pasarAProximaCapa ].
	mechaPuesta = #Diamante ifTrue: [ mechaPuesta := #Rota. self descripcionErrorAlRomperseLaMecha ].
	^self! !
!Perforadora methodsFor: 'excavation' stamp: 'tp 9/20/2023 16:03:40' prior: 50679160!
darGolpeDeTaladroEnConcreto

	mechaPuesta = #Soft ifTrue: [ mechaPuesta := #Rota. self descripcionErrorAlRomperseLaMecha  ].
	mechaPuesta = #Widia ifTrue: [ 
		vecesQueGolpeoCapaActual = 3 ifTrue: [ mechaPuesta := #Rota. self error: 'Se rompió' ].
		^self ].
	mechaPuesta = #Diamante ifTrue: [ 
		vecesQueGolpeoCapaActual even ifTrue: [ capasDeSueloDebajo first bajaUnDecimoDeResistencia].
		capasDeSueloDebajo first sinResistencia ifTrue: [ ^self transformarCapaEnArenoso].
		^vecesQueGolpeoCapaActual ]! !
!Perforadora methodsFor: 'excavation' stamp: 'tp 9/20/2023 16:03:40' prior: 50679237!
darGolpeDeTaladroEnConcreto

	mechaPuesta = #Soft ifTrue: [ mechaPuesta := #Rota. self descripcionErrorAlRomperseLaMecha  ].
	mechaPuesta = #Widia ifTrue: [ 
		vecesQueGolpeoCapaActual = 3 ifTrue: [ mechaPuesta := #Rota. self descripcionErrorAlRomperseLaMecha ].
		^self ].
	mechaPuesta = #Diamante ifTrue: [ 
		vecesQueGolpeoCapaActual even ifTrue: [ capasDeSueloDebajo first bajaUnDecimoDeResistencia].
		capasDeSueloDebajo first sinResistencia ifTrue: [ ^self transformarCapaEnArenoso].
		^vecesQueGolpeoCapaActual ]! !
!TestDePerforación methodsFor: 'test' stamp: 'tp 9/20/2023 16:16:00'!
unaCapaDeSueloArenoso

	^ CapaDeSuelo arenoso! !
!TestDePerforación methodsFor: 'test' stamp: 'tp 9/20/2023 16:16:00' prior: 50678040!
test01CuandoExcavaSueloArenosoConMechaSoftRemueveCapaArenosa

	| excavadora sueloAExcavar |
	
	sueloAExcavar := {
			self unaCapaDeSueloArenoso.
			CapaDeSuelo tierra.
			CapaDeSuelo concretoConResistencia: 5 } .
	
	excavadora := Perforadora sobreSuelo: sueloAExcavar.
	
	excavadora ponerMechaSoft.
	
	excavadora darGolpeDeTaladro.
	
	self assert: CapaDeSuelo tierra equals: excavadora capaDeSueloInmediata
	
	! !
!TestDePerforación methodsFor: 'test' stamp: 'tp 9/20/2023 16:16:00' prior: 50678242!
test14PuedeContarLasCapasDeTipoArenoso

	| excavadora sueloAExcavar |
	
	sueloAExcavar := { self unaCapaDeSueloArenoso setAltura: 2. CapaDeSuelo tierra setAltura: 40. CapaDeSuelo arenoso. CapaDeSuelo concretoConResistencia: 10 }.
	excavadora := Perforadora sobreSuelo: sueloAExcavar.
	
	self assert: 2 equals: (excavadora contarCapas: #Arenoso).

	! !
