!classRenamed: #GreaterThan1 as: #GreaterThan1Entero stamp: 'tp 9/14/2023 13:37:28'!
Smalltalk renameClassNamed: #GreaterThan1 as: #GreaterThan1Entero!
!Entero class methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:37:28' prior: 50660403!
with: aValue 
	
	"Esta verificacion esta puesta por si se equivocan y quieren crear un Entero pasando otra cosa que un Integer - Hernan"
	aValue isInteger ifFalse: [  self error: 'aValue debe ser anInteger' ].
	
	(aValue between: 0 and: 1) ifTrue: [^ZeroOrOne new initalizeWith: aValue].
	(aValue < 0) ifTrue: [^NegativeEntero new initalizeWith: aValue].

	^GreaterThan1Entero new initalizeWith: aValue! !

