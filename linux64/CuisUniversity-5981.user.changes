!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:34:15' prior: 50678557!
calcularProfundidadDelSuelo
	
	"| acc ix |

	acc := 0.
	ix := 1.
	
	[ix <= capasDeSueloDebajo size] whileTrue: [ | capa altura |
		capa := capasDeSueloDebajo at: ix.
		altura := capa altura.
		altura = nil ifTrue: [ altura := 0 ].
		acc := acc + altura.
		ix := ix + 1.		
	].

	^ acc."
	
	 ! !
!Perforadora methodsFor: 'scan' stamp: 'tp 9/21/2023 14:36:19' prior: 50681482!
calcularProfundidadDelSuelo
	
	| acc |
	
	capasDeSueloDebajo do: [ :capa |
		acc := acc + capa altura].
	
	^acc
	
	"| acc ix |

	acc := 0.
	ix := 1.
	
	[ix <= capasDeSueloDebajo size] whileTrue: [ | capa altura |
		capa := capasDeSueloDebajo at: ix.
		altura := capa altura.
		altura = nil ifTrue: [ altura := 0 ].
		acc := acc + altura.
		ix := ix + 1.		
	].

	^ acc."
	
	 ! !
