!OOStack methodsFor: 'enumerating' stamp: 'tp 9/17/2023 21:30:06'!
select: aBlock

	| newStack element |
	newStack := self class new.
	1 to: self size 
		do: [ :index |
			(aBlock value: (element := elements at: index))
			ifTrue: [ newStack addLast: element ]
			].
	^ newStack! !

