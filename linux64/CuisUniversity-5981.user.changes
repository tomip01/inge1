!Entero methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:36:02' prior: 50661246 overrides: 50660154!
addToFraccion: aFraccion1stAdder
	
	^self numerator: aFraccion1stAdder 
		 overCommonDenominatorWith: 	[aFraccion1stAdder numerator + (self value  * aFraccion1stAdder denominator)]
	
	
! !
!Entero methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:36:02' prior: 50661237 overrides: 50660179!
multiplyToFraccion: aFraccion1stMultiplier 
	
	^self numerator: aFraccion1stMultiplier 
		 overCommonDenominatorWith: 	[aFraccion1stMultiplier numerator * self]
	
	

	
	! !
!Entero methodsFor: 'as yet unclassified' stamp: 'tp 9/14/2023 13:36:02' prior: 50661228 overrides: 50660193!
substractToFraccion: aFraccionMinuend
	
	^self numerator: aFraccionMinuend 
		 overCommonDenominatorWith: 	[aFraccionMinuend numerator - (self value * aFraccionMinuend denominator) ]
	
! !

