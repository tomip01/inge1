		with: (self tenKilometerTurboSector)
		with: (SectorWithoutTurbo of: 20 * kilometer).
		
	positionInSector2 := 5 * kilometer.
	positionInTrack := sectors first length + positionInSector2.
	
	track := Track withSectors: sectors.
