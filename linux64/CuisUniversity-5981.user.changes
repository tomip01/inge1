	newStack := self class new.
	1 to: self size 
		do: [ :index |
			(aBlock value: (element := elements at: self size - index + 1 + 1)) "en size restamos 1, por eso el doble +1"
			ifTrue: [ newStack push: element value]
			].
	^ newStack!

