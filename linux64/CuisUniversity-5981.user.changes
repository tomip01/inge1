!classDefinition: #OOStack category: 'Stack-Exercise' stamp: 'tp 9/15/2023 13:11:13'!
Object subclass: #OOStack
	instanceVariableNames: 'items'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Stack-Exercise'!
!OOStack methodsFor: 'no messages' stamp: 'tp 9/15/2023 13:11:05' overrides: 16920235!
initialize
	items := OrderedCollection new! !
!OOStack methodsFor: 'testing' stamp: 'tp 9/15/2023 13:12:13'!
isEmpty
	
	^ items isEmpty! !
!OOStack methodsFor: 'errors' stamp: 'tp 9/15/2023 13:13:28'!
onEmptyStackRaiseError

	self isEmpty ifTrue: [^ self error: OOStack stackEmptyErrorDescription ]! !
!OOStack methodsFor: 'operations' stamp: 'tp 9/15/2023 13:14:27'!
top
	
	self onEmptyStackRaiseError 
	^ items last! !
!OOStack methodsFor: 'testing' stamp: 'tp 9/15/2023 13:14:45' overrides: 16901663!
size

	^items size! !
!OOStack methodsFor: 'operations' stamp: 'tp 9/15/2023 13:15:39'!
push: anItemToPush

	items add: anItemToPush ! !
!OOStack methodsFor: 'operations' stamp: 'tp 9/15/2023 13:16:29'!
pop
	
	self onEmptyStackRaiseError.
	^ items removeLast! !

