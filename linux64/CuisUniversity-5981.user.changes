!Track methodsFor: 'testing' stamp: 'tp 9/19/2023 16:23:29' prior: 50667545!
includes: aCar
	"Returns if any of the sectors includes aCar"
	
	^self cars includes: aCar.
	
	"| inc ix sector |
	inc := false.
	ix := 1.
	
	(sectors size = 0) ifTrue: [ ^ inc ].
	
	sector := sectors at: ix.
	(sector includes: aCar) 
		ifTrue: [ inc := true]
		ifFalse: [
			ix := ix +1.
			[ix <= sectors size] whileTrue: [ | s |
				s := sectors at: ix.
				(s includes: aCar) ifTrue: [ ^ true ].
				ix := ix + 1
			]	
		]. 
	^ inc"
	! !

