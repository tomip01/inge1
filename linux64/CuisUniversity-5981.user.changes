!FormulaOneCar methodsFor: 'initialization' stamp: 'tp 9/19/2023 15:00:03' prior: 50667650!
initializeDrivenBy: aDriver 

	driver := aDriver.
	turboStatus := TurboDeactivated next: TurboActivated firstInActivationChain.
	speed := 0*kilometer/hour.
	traveledDistance := 0.
	! !
!FormulaOneCar methodsFor: 'moving' stamp: 'tp 9/19/2023 15:01:52' prior: 50667131!
speed

	^ speed * turboStatus speedingRatio! !
!FormulaOneCarTurboStatus methodsFor: 'speed' stamp: 'tp 9/19/2023 15:02:55'!
speedingRatio

	^ self subclassResponsibility .! !
!TurboActivated methodsFor: 'speed' stamp: 'tp 9/19/2023 15:03:24' overrides: 50667942!
speedingRatio
	
	^speedingRatio ! !
!TurboDeactivated methodsFor: 'speed' stamp: 'tp 9/19/2023 15:03:37' overrides: 50667942!
speedingRatio
	
	^speedingRatio ! !

