negated

	^self class with: numerator * (self class with: -1) over: denominator! !
!Fraccion methodsFor: 'arithmetic operations' stamp: 'tp 9/9/2023 16:30:14' overrides: 50654153!
printOn: aStream

	aStream 
		print: numeratorOld;
		nextPut: $/;
		print: denominatorOld! !
