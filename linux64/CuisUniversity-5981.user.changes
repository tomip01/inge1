!OOStack methodsFor: 'enumerating' stamp: 'tp 9/17/2023 23:03:01' prior: 50665402!
select: aBlock

	| newStack element |
	newStack := self class new.
	1 to: self size 
		do: [ :index |
			(aBlock value: (element := elements at: self size -index + 1))
			ifTrue: [ newStack push: element ]
			].
	^ newStack! !
