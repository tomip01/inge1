multiplyToFraccion: aFraccion1stMultiplier 
	
	| newNumerator newDenominator |

	newNumerator := aFraccion1stMultiplier numerator * self.
	newDenominator := aFraccion1stMultiplier denominator.
		
	^newNumerator / newDenominator 
	
	

	
	! !
!Entero methodsFor: 'arithmetic operations' stamp: 'tp 9/13/2023 14:21:30'!
xx: aFraccion1stAdder
	
	|newNumerator newDenominator | 
	
	newNumerator := aFraccion1stAdder numerator + (self value  * aFraccion1stAdder denominator) .
	newDenominator := aFraccion1stAdder denominator.
		
	^newNumerator / newDenominator 
	
	
! !
!Entero methodsFor: 'arithmetic operations' stamp: 'tp 9/13/2023 14:21:43' prior: 50660993!
xx: yy
	
	|newNumerator newDenominator | 
	
	newNumerator := yy numerator + (self value  * yy denominator) .
	newDenominator := yy denominator.
		
	^newNumerator / newDenominator 
	
	
! !
!Fraccion methodsFor: 'arithmetic operations' stamp: 'tp 9/13/2023 14:23:57' prior: 50660515 overrides: 50660154!
addToFraccion: aFraccion1stAdder
	
	| newNumerator newDenominator |
	
	newNumerator := (aFraccion1stAdder numerator * self denominator) + (aFraccion1stAdder denominator * self numerator).
	newDenominator := aFraccion1stAdder commonDenominatorWith: self.
		
	^newNumerator / newDenominator 
		
	
	
	
	
	
	
	! !

